{
  "opencollection": "1.0.0",
  "info": {
    "name": "Chartmetric Albums Authentication API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Authentication",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Mint an access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.chartmetric.com/api/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange a long-lived refresh token for a short-lived (1 hour) access token. Reuse the access token across requests until it expires."
        }
      ]
    }
  ],
  "bundled": true
}