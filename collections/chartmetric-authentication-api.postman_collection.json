  ],
  "event": [],
  "variable": [
    {
      "type": "string",
      "value": "https://api.chartmetric.com/api",
      "key": "baseUrl"
    }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
