{
  "item": [
    {
      "id": "9136374b-0f67-4cd1-a4c1-89572714c6f3",
      "name": "Authentication",
      "description": {
        "content": "Exchange a refresh token for a short-lived access token.",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "fdccbc4b-3af4-4bfa-b595-143841ee19e7",
          "name": "Mint an access token",
          "request": {
            "name": "Mint an access token",
            "description": {
              "content": "Exchange a long-lived refresh token for a short-lived (1 hour) access token. Reuse the access token across requests until it expires.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "token"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshtoken\": \"<string>\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "7f223a0d-dbc9-4a62-a5a7-70a82ebba245",
              "name": "An access token and its expiration.",
              "originalRequest": {
                "url": {
                  "path": [
                    "token"
                  ],
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "query": [],
                  "variable": []
                },
                "header": [
                  {
                    "description": {
                      "content": "Added as a part of security scheme: bearer",
                      "type": "text/plain"
                    },
                    "key": "Authorization",
                    "value": "Bearer <token>"
                  },
                  {
                    "key": "Accept",
                    "value": "application/json"
                  }
                ],
                "method": "POST",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"refreshtoken\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "language": "json"
                    }
                  }
                }
              },
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                }
              ],
              "body": "{\n  \"token\": \"string\",\n  \"expires_in\": 3600,\n  \"scope\": \"string\",\n  \"refresh_token\": \"string\"\n}",
              "cookie": [],
              "_postman_previewlanguage": "json"
            },
            {
              "id": "17bd99fd-a863-41ef-b60d-90ecab174a3f",
              "name": "Missing or invalid access token.",
